{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"compilerOptions": {
		"deleteOutDir": true,
		"assets": [
			{
				"include": "modules/communication/email/templates/**/*",
				"outDir": "dist"
			},
			{
				"include": "assets/**/*",
				"outDir": "dist"
			}
		]
	}
}
