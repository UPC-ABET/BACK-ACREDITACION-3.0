# ============================================================
# ABET Backend — environment template
# Copy to .env locally (dev) and create a separate .env on the
# server (prod). NEVER commit the real .env (it is gitignored).
# ============================================================

# --- App ---
APP_PORT=7777
LOG_LEVEL=log
NODE_ENV=production

# --- Secrets (generate strong random values; do NOT reuse dev values in prod) ---
JWT_SECRET=change-me
APP_SECRET=change-me
COOKIE_SECRET=change-me
DEFAULT_USER_PASSWORD=change-me

# --- Database ---
# PROD: Postgres runs on the host (startup-abet script). From inside the
# container the host is reachable as host.docker.internal.
# Standardized DB/user: db_sys_acc / sys_acc_app (see /root/DB_CREDENTIALS.txt on server).
DB_TYPE=postgres
DB_HOST=host.docker.internal
DB_PORT=5432
DB_USER=sys_acc_app
DB_PASSWORD=change-me
DB_NAME=db_sys_acc
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONN_TIMEOUT=5000

# --- URLs / CORS (use your real domain in prod) ---
APP_FRONTEND_URL=https://accreditation.tcupc.pe
CORS_ALLOWED_ORIGINS=https://accreditation.tcupc.pe

# --- Email (SMTP) ---
# All optional: if SMTP_HOST is unset the app still boots, but email sending
# (survey/IFC notifications) is disabled until you configure these.
# secure is inferred from the port (465 = implicit TLS; 587/25 = STARTTLS).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=change-me
SMTP_PASS=change-me
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true