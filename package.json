{
	"name": "api-base",
	"version": "0.0.1",
	"description": "API Base - NestJS",
	"author": "Francisco Cáceres",
	"private": true,
	"license": "UNLICENSED",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"build": "nest build",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main.js",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register ./node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/database/typeorm.config.ts",
		"migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/typeorm.config.ts",
		"migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/database/typeorm.config.ts",
		"seed:all": "ts-node -r tsconfig-paths/register src/database/scripts/seed-all.ts",
		"seed:initial": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/initial.seed.ts",
		"seed:drop": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/0-drop-schema.ts",
		"seed:types": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/1-load-types.ts",
		"seed:core": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/2-core.seed.ts",
		"seed:organization": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/3-organization.seed.ts",
		"seed:auth": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/4-auth.seed.ts",
		"seed:academic": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/5-academic.seed.ts",
		"seed:accreditation": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/6-accreditation.seed.ts",
		"seed:evaluation": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/7-evaluation.seed.ts",
		"seed:evidence": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/8-evidence.seed.ts",
		"seed:ifc": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/9-ifc.seed.ts",
		"seed:improvement": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/10-improvement.seed.ts",
		"seed:survey": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/11-survey.seed.ts",
		"seed:notifications": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/12-notifications.seed.ts",
		"seed:auth-roles-permissions": "ts-node -r tsconfig-paths/register src/database/scripts/seeds/upc/13-auth-roles-permissions.seed.ts",
		"lint": "eslint \"src/**/*.{ts,tsx}\"",
		"lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
		"check": "npm run lint:fix && npm run format && tsc --noEmit",
		"format": "prettier --write \"src/**/*.{ts,tsx,json,md}\" --log-level error",
		"create:entity-structure": "bash src/tools/create-entity-structure.sh && npm run format && npm run lint:fix",
		"create:entity-relations": "bash src/tools/create-entity-relations.sh && npm run format && npm run lint:fix",
		"create:entity-dtos": "bash src/tools/create-entity-dtos.sh && npm run format && npm run lint:fix",
		"create:entity-full": "npm run format && npm run create:entity-dtos && npm run create:entity-relations",
		"create:dbdiagram": "bash src/tools/create-db-diagram.sh",
		"generate:db": "bash src/tools/generate-db.sh"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1061.0",
		"@azure/msal-node": "^5.2.1",
		"@nestjs/axios": "^4.0.1",
		"@nestjs/cache-manager": "^3.1.2",
		"@nestjs/common": "^11.0.16",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.16",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.0.16",
		"@nestjs/swagger": "^11.2.5",
		"@nestjs/typeorm": "^11.0.0",
		"archiver": "^8.0.0",
		"axios": "^1.13.2",
		"bcryptjs": "^3.0.3",
		"cache-manager": "^7.2.8",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cookie-parser": "^1.4.7",
		"dotenv": "^16.4.5",
		"exceljs": "^4.4.0",
		"glob": "^13.0.6",
		"handlebars": "^4.7.8",
		"js-base64": "^3.7.7",
		"nodemailer": "^7.0.13",
		"p-limit": "^7.3.0",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"pg": "^8.18.0",
		"puppeteer": "^25.0.2",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"swagger-ui-express": "^5.0.1",
		"ts-morph": "^27.0.2",
		"typeorm": "^0.3.20",
		"typeorm-naming-strategies": "^4.1.0",
		"uuid": "^11.1.0",
		"xlsx": "^0.18.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nestjs/cli": "^11.0.16",
		"@nestjs/schematics": "10.0.0",
		"@nestjs/testing": "^11.0.16",
		"@types/archiver": "^7.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/multer": "^2.1.0",
		"@types/node": "^20.11.30",
		"@types/nodemailer": "^6.4.17",
		"@types/supertest": "^6.0.0",
		"eslint": "^10.4.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"globals": "^17.6.0",
		"jest": "^29.7.0",
		"prettier": "^3.8.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.0.0",
		"ts-jest": "^29.1.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typeorm-ts-node-commonjs": "^0.3.20",
		"typescript": "^5.3.3",
		"typescript-eslint": "^8.59.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": "src",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"moduleNameMapper": {
			"^src/(.*)$": "<rootDir>/$1"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "../coverage",
		"testEnvironment": "node"
	}
}
